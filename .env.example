# Server-side only. Never expose these to the browser.
OPENAI_API_KEY=
QLOO_API_KEY=
# hackathon keys only work against this host
QLOO_BASE_URL=https://hackathon.api.qloo.com
# "mock" uses synthetic data (no Qloo key needed)
QLOO_MODE=mock
# optional: model for public runs (default gpt-4.1-mini) and the no-data baseline
# COMPS_MODEL=gpt-4.1-mini
# COMPS_BASELINE_MODEL=gpt-4.1-mini
# COMPS_DAILY_CAP=50
