# Server-side only. Never expose these to the browser.
OPENAI_API_KEY=
QLOO_API_KEY=
# hackathon keys only work against this host
QLOO_BASE_URL=https://hackathon.api.qloo.com
# "mock" uses synthetic data (no Qloo key needed)
QLOO_MODE=mock
# optional: report model (default gpt-4.1), the no-data baseline model, daily cap on new reports
# COMPS_MODEL=gpt-4.1
# COMPS_BASELINE_MODEL=gpt-4.1
# COMPS_DAILY_CAP=30
